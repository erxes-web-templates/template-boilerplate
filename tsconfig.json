{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "baseUrl": ".",
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@site-core/*": ["./core/*", "../../../packages/site-core/*"],
      "@/lib/*": ["./core/lib/*", "../../../packages/site-core/lib/*"],
      "@/graphql/*": ["./core/graphql/*", "../../../packages/site-core/graphql/*"],
      "@/hooks/*": ["./core/hooks/*", "../../../packages/site-core/hooks/*"],
      "@/types/*": ["./core/types/*", "../../../packages/site-core/types/*"],
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
